# Copy this file to .env.local for local development, and set the same
# names as Environment Variables in the Vercel project for production.
# Never commit real values — this file only holds placeholders.

# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Resend (email) ────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
# "From" address used by the unified notification dispatcher
# (lib/notifications/resend.ts). Must be a verified sender/domain in Resend.
RESEND_FROM_EMAIL=OrisAlign <no-reply@orisalign.com>

# ── AiSensy (WhatsApp) ────────────────────────────────────────────────────
# Used by lib/notifications/aisensy.ts. Campaign names it sends are defined
# in lib/notifications/notify.ts (AISENSY_CAMPAIGNS) — they must match the
# campaign names created in the AiSensy dashboard exactly.
AISENSY_API_KEY=your-aisensy-api-key

# ── Razorpay ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ── Online Smile Report flow ────────────────────────────────────────────────
# Recipient for "new submission" / "interest" / "payment received" alerts —
# see app/api/online-report/*.
ONLINE_REPORT_ADMIN_EMAIL=leads@orisalign.com
# Used to build the absolute /report/[id] link sent to patients when their
# report is ready (app/api/online-report/notify-report-ready). Should be the
# preview/staging URL for now, per the "don't deploy to production yet"
# instruction — update to the live domain only after approval.
NEXT_PUBLIC_SITE_URL=https://your-preview-url.vercel.app
